# Tinubu E2E Environment Configuration
# Copy to .env and fill in values

# Application URL
BASE_URL='http://localhost:3000'

# Test user credentials
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Admin credentials (for setup/seeding)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# CI environment (optional — set by your CI platform)
# CI=true
# AZURE=true
# AWS_CODEBUILD=true
# GITHUB_ACTIONS=true

# Timeout overrides (milliseconds, optional)
# PLAYWRIGHT_TIMEOUT=1200000
# ACTION_TIMEOUT=60000
# EXPECT_TIMEOUT=30000
# NAVIGATION_TIMEOUT=90000

# Workers override (optional)
# Workers=4
